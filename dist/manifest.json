{
  "manifest_version": 3,
  "name": "X Bulk Scheduler",
  "short_name": "X Bulk Scheduler",
  "version": "1.0.0",
  "description": "Bulk-schedule posts into X's native scheduled-post queue using your logged-in browser session.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open X Bulk Scheduler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html#settings",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
